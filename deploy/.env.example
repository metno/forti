# Registry prefix for all service images.
# Default: ghcr.io/metno/forti
IMAGE_REPO=ghcr.io/metno/forti

# Tag to pull for all service images (e.g. v0.8.0, v0, latest).
# Default: latest
IMAGE_TAG=v0.8.0

# Path to local forecast data directory (rawdataforecaster).
# FORECAST_DATA_PATH=../data/forecast

# Path to local topography data directory (correctedforecaster profile).
# TOPOGRAPHY_DATA_PATH=../data/topography

# Override the upstream gRPC address for jsonfrontend.
# JSONFRONTEND_UPSTREAM=rawdataforecaster:5052
